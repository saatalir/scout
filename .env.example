# Copy to .env and fill in.

# --- Strata machine (reached over Tailscale) --------------------------------
# Tailnet hostname or 100.x.y.z address of the Strata box, including /v1.
STRATA_BASE_URL=https://strata-host.your-tailnet.ts.net/v1
# The key Strata was started with ("none" if Strata runs without auth).
STRATA_API_KEY=none
# Pin the model so Scout never silently uses another one. "auto" = the first
# model the server lists at /v1/models.
STRATA_MODEL=qwen3.8-flash-next-unsloth-ud-q4_k_xl

# --- Routing -----------------------------------------------------------------
# direct  = Scout talks straight to Strata (simplest; fine for Phase 0)
# litellm = Scout talks to the LiteLLM proxy and asks for roles
SCOUT_ROUTER=direct
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_API_KEY=sk-scout-local

# --- Timeouts ----------------------------------------------------------------
# Strata's first request after a load can be slow while the expert cache warms.
SCOUT_REQUEST_TIMEOUT=300

# --- Browser VM (config/browsers.yaml reads these) ----------------------------
# Tailnet name (or 100.x address) of the browser VM, and the tailnet's DNS suffix.
SCOUT_VM_HOST=browser-vm
SCOUT_TAILNET=your-tailnet.ts.net
SCOUT_VM_USER=scout
# Scout's own SSH key for the VM (docs/SETUP.md §4.3).
SCOUT_SSH_KEY=~/.ssh/scout_ed25519
# Time zone the browsers report (IANA name). Tor profiles always use UTC.
SCOUT_TIMEZONE=UTC
# Tor for web searches: ask = Scout asks you (on/off) before searching;
# on = always through Tor; off = always direct. A per-call choice overrides it.
SCOUT_TOR=ask

# --- Scrubbing captured pages (scout/tools/scrub.py) --------------------------
# Place names and ISO country codes that engines show for where you search from;
# removed from saved result pages before they become test fixtures.
SCOUT_SCRUB_PLACES=
SCOUT_SCRUB_REGIONS=
